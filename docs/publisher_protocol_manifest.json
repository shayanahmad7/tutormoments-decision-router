  "scope": "Public publisher code/prompts only; no corpus or credentials included.",
  "protocol": {
    "tutor": {
      "model": "gpt-5.5-2026-04-23",
      "arm_condition": "high",
      "reasoning_effort": "high",
      "max_completion_tokens": 128000,
      "temperature": "not sent",
      "wire": "one user message: rendered tutor template + two newlines + conversation heading + formatted fixed prefix + generated suffix + two newlines + role instruction",
      "baseline_templates": [
        "tutor/plain.txt",
        "tutor/scaffolding_rigor.txt"
      ],
      "template_whitespace": "strip() before substitution"
    },
    "student": {
      "model": "claude-opus-4-6",
      "thinking": {
        "type": "disabled"
      },
      "mode": "oracle",
      "persona": "released frozen student.trait.persona; missing is hard error",
      "reference": "released post-cut student.reference, empty-reference fallback in student.py",
      "metadata": "student.context",
      "template_whitespace": "rstrip(newline) before substitution",
      "max_tokens": 128000
    },
    "rollout": {
      "max_speaking_calls": 5,
      "sequence": [
        "TUTOR",
        "STUDENT",
        "TUTOR",
        "STUDENT",
        "TUTOR"
      ],
      "count_unit": "one LLM call, regardless of split messages",
      "next_turn_number": "cut_turn+1; increment for every split message",
      "split_tokens": [
        "[NEXT]",
        "[NEW_MESSAGE]"
      ],
      "tutor_stop_tokens": [
        "[END]",
        "[PROBLEM_CHANGE]",
        "[NEXT_PROBLEM]"
      ],
      "stop_precedence": "END over problem change; checked before next student",
      "blank_response": "tutor ... unless stop token; student ...",
      "student_control_tokens": "no stopping parse; only split messages"
    },
    "scorer": {
      "model": "claude-opus-4-6",
      "thinking": {
        "type": "adaptive"
      },
      "execution": "three pooled batch passes; pass2 has two prompts",
      "annotate": "scaffolding lens; generated range only, context_before=context_after=0; gold category translated into teacher suggestion",
      "annotate_schema": {
        "situation": "string",
        "action": "string",
        "result": "string"
      },
      "decompose_action": "JSON array of strings; JSON object wrapping also coerced by publisher",
      "decompose_overscaffold": "JSON array of quoted spans indicating excess support; nonempty means over-scaffold detected",
      "structure_schema": {
        "scaffolding": "yes|no",
        "rigor": "yes|no"
      },
      "structure_mapping": {
        "yes,yes": "both",
        "yes,no": "scaffolding",
        "no,yes": "rigor",
        "no,no": "neither",
        "parse failure": "unclear",
        "no action facets": "neither"
      },
      "student_outcome_classifier": "inactive in current scorer; do not run as official score"
    },
    "metrics": {
      "appropriate_scaffolding": "category=scaffolding and action_label in [scaffolding,both] and empty over-scaffold spans, divided by all scaffolding category cases",
      "appropriate_rigor": "category=rigor and action_label in [rigor,both] and empty over-scaffold spans, divided by all rigor category cases",
      "avoids_overscaffolding": "1 - fraction with nonempty over-scaffold spans"
    },
    "experimental_change": {
      "router": "new Decisions call per tutor opportunity; context dialogue + generated dialogue only; no label/rubric/reference/persona/future",
      "intervention": "additional developer message for next tutor reply only; original user payload unchanged; excluded from student/scorer/history"
    }
  }
